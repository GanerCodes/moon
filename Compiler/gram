supscript   = ~‹%SUPSCRIPT%+›
subscript   = ~‹%SUBSCRIPT%+›
_op_⸓_l     = ~‹%OP_MOD_L%›
_op_⸓_r     = ~‹%OP_MOD_R%›
op_lit      = ~‹%OP_LIT%›
𝑉_spec      = ~‹%VAR_SPEC%›
    std_kwd = ~‹%STD_KWDS%›
blk_cln_kwd = ~‹%BLK_CLN_KWDS%›
    blk_kwd = ~‹%BLK_KWDS%›

parser_main    = stmts?
parser_comment = (⠶str ∨ 󰆴comment ∨ ~‹.|\n›)*

stmts      = 󰆴𝗪? ( stmt      󰆴𝗪?)+
multi_expr = 󰆴𝗪? (⠶norm_expr 󰆴𝗪?)+

stmt  = blk_head ∨ native_imp ∨ kwd_std ∨ asgn ∨ norm_expr
blk_head = ⊢_dec ∨ cln_pfx ∨ std_pfx
⊢_dec   = 󰆴("⊢" 𝗪?) (wrap=(grp 󰆴𝗪? ∨ ✓)) 𝑉 󰆴(𝘄? "(" 𝗪?) (ƒ_dec_params ∨ ✓) 󰆴(𝗪? ")" 𝗪? ":" 𝘄?)
kwd_std =     std_kwd 󰆴𝘄? (norm_expr      ∨ ✓)
cln_pfx = blk_cln_kwd 󰆴𝗪? (expr_not_colon ∨ ✓) 󰆴(𝗪? ":" 𝘄?)
std_pfx =     blk_kwd 󰆴𝘄?

norm_expr = (⠶norm_expr_atom)+

native_imp = (
  (native_imp_from   = (󰆴('⮌' 𝘄?) ~‹[^ \t\n⨡]+› 󰆴𝘄?))?
  (native_imp_fields = (
      󰆴('⨡' 𝘄?) native_imp_targ (󰆴',' native_imp_targ)* )))
native_imp_targ = ~‹[^ \t\n:]+› (󰆴(':' 𝘄?) ~‹[^ \t\n,]+›)? 󰆴𝘄?
                 
asgn = ⠶asgn_left 󰆴(𝘄? ↷ '=') (asgn ∨ norm_expr)
asgn_targ = ⠶asgn_grp ∨ asgn_𝔸 ∨ ƒ_val
asgn_grp = 󰆴('(' 𝗪?) ⠶asgn_left 󰆴(𝗪? ')' 𝘄?) ⮞(~‹[,=)]|\Z›)
asgn_targs = (⠶asgn_targ 󰆴(',' 𝘄?))+ ⠶asgn_targ?
asgn_left = asgn_targs ∨ asgn_targ
asgn_𝔸 = 󰆴(𝘄? ↷ '⠤') asgn_targ

expr_not_colla = (¬(',' ∨ ':') ⠶bruh_expr_atom)+
expr_not_colon = (¬(      ':') ⠶rard_expr_atom)+
expr_not_comma = (¬(','      ) ⠶norm_expr_atom)+

ƒ_dec_params = ((⠶ƒ_dec_param 󰆴(',' 𝗪?))+ ⠶ƒ_dec_param?) ∨ ⠶ƒ_dec_param
ƒ_run_params = ((⠶ƒ_run_param 󰆴(',' 𝗪?))+ ⠶ƒ_run_param?) ∨ ⠶ƒ_run_param
ƒ_dec_param = ƒ_kw ∨ (ƒ_dec_𝔸 ∨ ƒ_dec_𝕂 ∨ ƒ_𝑉  ) 󰆴𝘄?
ƒ_run_param = ƒ_kw ∨ (ƒ_run_𝔸 ∨ ƒ_run_𝕂 ∨ ƒ_val) 󰆴𝘄?

ƒ_dec_𝔸 = 󰆴(𝘄? ↷ '⠤') ⠶ƒ_𝑉
ƒ_dec_𝕂 = 󰆴(𝘄? ↷ '⠶') ⠶ƒ_𝑉
ƒ_run_𝔸 = 󰆴(𝘄? ↷ '⠤') ⠶ƒ_val
ƒ_run_𝕂 = 󰆴(𝘄? ↷ '⠶') ⠶ƒ_val

ƒ_kw  = ⠶ƒ_𝑉 󰆴(𝘄? '=' 𝗪?) ƒ_val
ƒ_val = (¬(',' ∨ '=' ∨ lamb_h_implicit) 󰆴𝘄? (lamb ∨ whiskers ∨ ⠶gen_expr_atom) 󰆴𝘄?)+
ƒ_𝑉 = ⠶𝑉

norm_expr_atom = ( slice ∨ ⠶rard_expr_atom) 󰆴𝘄?
rard_expr_atom =  ⠶lambs ∨ ⠶bruh_expr_atom
 gen_expr_atom =   slice ∨ ⠶bruh_expr_atom
bruh_expr_atom = grp ∨ ugx_expr ∨ ⠶stars ∨ ⠶str ∨ 𝑉_spec ∨ number_exp ∨ number ∨ op ∨ ⠶script ∨ 𝑉
 
slice = ((expr_not_colla? ↷ (':' 󰆴𝘄?)+) expr_not_colla?)+
stars = ƒ_run_𝔸 ∨ ƒ_run_𝕂
 
pos_num = ƨ(~‹0([bB][01]+|[oO][0-7]+|[xX][0-9a-fA-F]+)|([0-9]+(\.[0-9]*)?|[0-9]*\.[0-9]+)(e[+\-]?[0-9]+)?›)
neg_num = ƨ(~‹󷰽([󷱈󷱐][󷰽󷰾]+|[󷱍󷱕][󷰽-󷱄]+|[󷱎󷱖][󷰽-󷱆󷱇-󷱌󷱏-󷱔]+)|([󷰽-󷱆]+(\.[󷰽-󷱆]*)?|[󷰽-󷱆]*\.[󷰽-󷱆]+)(󷱋[+\-]?[󷰽-󷱆]+)?›)
number = pos_num ∨ neg_num
number_exp = number supscript

script = supscript ∨ subscript
grp = ~‹[\[({⁅⟦]› (󰆴𝗪? ↷ (multi_expr ∨ ✓)) ~‹[\])}⁆⟧]›

𝑉_bad = 𝗪 ∨ ~‹󰦥{5}|[⍈󷸴⍮⟥⟤⭡⭣𝗮-𝘇𝟬-𝟵󷺗ᐸᐳᑅᑀᐘᐒᑈᐵᐛᐖ󷺹-󷻀⥌↦𝚲󰲟󰲡󰲣󰲥󰲧󰲩󰲫󰲭󰲯󰲱󰅂$"'\[\](){}⁅⁆⟦⟧⟨⟩‹ ␛␛␛›]› ∨ op ∨ 𝑉_spec ∨ blk_cln_kwd ∨ script
𝑉 = 󰆴'´' ~‹[^´]+› 󰆴'´' ∨ ƨ((¬𝑉_bad ~‹.›)+)

op = ((op_⸓_l = ƨ((_op_⸓_l (_op_⸓_l ∨ supscript)*)?))
       op_lit
      (op_⸓_r = ƨ((        (_op_⸓_r ∨ supscript)*) )))

lambs = (  (whiskers=(    (⠶LTL (norm_expr      ∨ ✓) ⠶LTR)
                        ∨ (⠶LTL (expr_not_comma ∨ ✓) ✓ ✓)))
         ∨ (lamb    =((   (󰆴('⥌' 𝗪?) (ƒ_dec_params ∨ ✓) 󰆴'↦')
                        ∨ (lamb_h_preset = ~"[𝚲󰲟󰲡󰲣󰲥󰲧󰲩󰲫󰲭󰲯󰲱]")
                        ∨ (lamb_h_implicit = ⠶ƒ_𝑉 󰆴(𝗪? '↦'))) 󰆴𝗪?
                      (norm_expr 󰆴'󰅂' ∨ expr_not_comma))))

LTL = (‹⟥›∨✓) ~‹[ᐳᑀᐒᐵᐖ󷺹󷺻󷺺󷺼]› 󰆴𝗪?
LTR = ~‹[ᐸᑅᐘᑈᐛ󷺽󷺿󷺾󷻀]› (‹⟤›∨✓)

str = str_tsys ∨ ((str_t󰦥 ∨ str_tsub ∨ str_nsub ∨ ⠶str_gen_inner) 󰆴𝘄?)+
str_t󰦥   = (󰆴(~‹󰦥{5}›)) ~‹((?!󰦥{5})(.|\n))*› 󰆴((~‹󰦥{5}›) ∨ ✓)
str_tsys = 󰆴('$' 𝘄?) (ƨ(supscript) ∨ ✓) 󰆴𝘄? (
                                (⠶str_sub_inner ∨ ( str_tsys_guts=~‹[^𝗮-𝘇𝟬-𝟵󷺗␛␛⟦󷹹]+› ))* 󰆴(𝘄? '󷹹'))
str_tsub = 󰆴'‹'                ((⠶str_sub_inner ∨ ( str_tsub_guts=~‹[^𝗮-𝘇𝟬-𝟵󷺗␛␛⟦␛›]+›))* 󰆴'›'     )
str_nsub = ⠶(  (str_nsub1=(󰆴‹"› (⠶str_gen_inner ∨ (str_nsub1_guts=~‹[^𝗮-𝘇𝟬-𝟵󷺗␛␛"]+›))* 󰆴‹"›))
             ∨ (str_nsub2=(󰆴‹'› (⠶str_gen_inner ∨ (str_nsub2_guts=~‹[^𝗮-𝘇𝟬-𝟵󷺗␛␛']+›))* 󰆴‹'›)))

str_sub_inner = ⠶str_gen_inner ∨ str_sub
str_gen_inner = (str_escape ∨ 󰆴‹󷺗› ∨ str_spec_char)+
str_sub = 󰆴'⟦' norm_expr 󰆴'⟧'
str_spec_char = ~‹[𝟬-𝟵𝗮-𝗳]{2}› ∨ ~‹[𝗮-𝘇󷺗]›
str_escape = 󰆴"␛␛" ~‹.›
str_guts = ~‹[^𝗮-𝘇𝟬-𝟵󷺗⟦␛␛␛›'"󷹹]+›

ugx_expr  = ⮞ugx_brack ugx_brack
ugx_mod   = ~‹[􊽨⁺􋅋􊽬]›
ugx_and   = ⠶ugx_atom+
ugx_or    = ugx_and 󰆴('󷸴' 𝗪?) (⠶ugx_or ∨ ugx_and)
ugx_☾     = multi_expr 󰆴'⍮'? (mod:ugx_mod)?
ugx_seq   = ((ugx_or ∨ ⠶ugx_atom) 󰆴𝗪?)+ (apply:(󰆴('⍈' 𝗪?) multi_expr))?
ugx_atom  = (ugx_group ∨ ugx_☾) 󰆴𝗪?
ugx_group = (ugx_paren ∨ ugx_brack)
ugx_gtail = (mod:(󰆴𝗪? ∧ ugx_mod))? (󰆴𝘄? ∧ stk:subscript)?
ugx_paren = 󰆴(‹(› 𝗪?) ⠶ugx_seq 󰆴(‹)›) ⠶ugx_gtail
ugx_brack = 󰆴(‹⟨› 𝗪?) ⠶ugx_seq 󰆴(‹⟩›) ⠶ugx_gtail

𝘄 = ~‹([ \t]*␛␛\n[ \t]*)+|[ \t]+›
𝗪 = (𝘄 ∨ ~‹[ \t\n]+›)+
text_breaker = ⮞(𝘄 ∨ 𝑉_spec ∨ ¬𝑉)
INDENT_LOC = ✓

comment = ~‹((|#)[^\n]*(?=\n|\Z))|(🟑[^🟑]*(🟑|\Z))|(֎[^֎]*(֎|\Z))›