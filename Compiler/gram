op_⸓_ln     = ~‹%OP_MOD_L_N%›
op_⸓_ly     = ~‹%OP_MOD_L_Y%›
op_⸓_rn     = ~‹%OP_MOD_R_N%›
op_⸓_ry     = ~‹%OP_MOD_R_Y%›
op_lit      = ~‹%OP_LIT%›
𝑣_spec      = ~‹%VAR_SPEC%›
    std_kwd = ~‹%STD_KWDS%›
blk_cln_kwd = ~‹%BLK_CLN_KWDS%›
    blk_kwd = ~‹%BLK_KWDS%›

SB='󰜞'
SP='󰜚'
SE='󰜛'

parse_main = stmts?
parse_comm = (⠶(str ∨ native_code) ∨ 󰆴comment ∨ ~‹.|\n›)*

stmts   = (stmt ∨ 𝗪 ∨ 󰆴';')+
stmt = native_imp ∨ blk_head ∨ kwd_std ∨ asgn ∨ 𝑋↑↑

blk_head = ⊢_dec ∨ cln_pfx ∨ std_pfx
⊢_dec    = 󰆴'⊢' 𝖶 (wrap = 𝑃 𝖶 ∨ ✓) (𝑣𝕒 ∨ ✓) 𝖶 (𝑃 ∨ ✓) 𝖶 󰆴':' 𝖶
kwd_std  =     std_kwd 𝗐 (𝑋↑↑ ∨ ✓)
cln_pfx  = blk_cln_kwd 𝖶 (𝑋↑↓ ∨ ✓) 𝖶 󰆴':' 𝖶
std_pfx  =     blk_kwd 𝗐
asgn     = 𝑋↑↑ 𝗐 󰆴'=' 𝗐 (asgn ∨ 𝑋↑↑)

lambs = (  (whiskers=(    (⠶W_L 𝖶 (𝑋↑↑ ∨ ✓) ⠶W_R)
                        ∨ (⠶W_L 𝖶 (𝑋↓↑ ∨ ✓) ✓ ✓)))
         ∨ (    lamb=((   (lamb_h_preset   =   ~‹[𝚲󰲟󰲡󰲣󰲥󰲧󰲩󰲫󰲭󰲯󰲱]›)
                        ∨ (lamb_h_normal   = 󰆴'⥌' (𝑝𝑐 ∨ 𝖶) 󰆴'↦')
                        ∨ (lamb_h_implicit =         𝑣𝕒 𝖶  󰆴'↦')
                      ) 𝖶 (𝑋↑↑ 󰆴'󰅂' ∨ 𝑋↓↑))))

grp = ~‹[{⁅⟦]› ⠶𝑝𝑐 ~‹[}⁆⟧]›
𝐿 = 󰆴'[' ⠶𝑝𝑐 󰆴']' ∨ 󰆴SB ⠶𝑝𝑐 󰆴SE
𝑃 = 󰆴'(' ⠶𝑝𝑐 󰆴')'
𝑝𝑐 = 𝗐 ⠶𝑎𝑝𝑐 𝗐 (󰆴',' 𝗐 ⠶𝑎𝑝𝑐 𝗐)*
𝑎𝑝𝑐 = (kw_𝕒 = 𝑣𝕒 𝖶 󰆴'=' 𝖶 𝑋↓↑) ∨ 𝑋↓↑
𝑋↑↑ = 𝑇↑ ∨ (⠶𝑋↓↑ 𝗐)+
𝑋↑↓ = 𝑇↓ ∨ (⠶𝑋↓↓ 𝗐)+
𝑋↓↑ =      (⠶𝑎↓↑ 𝗐)+
𝑋↓↓ =      (⠶𝑎↓↓ 𝗐)+
𝑇↑  = (𝑋↓↑ ∨ ᗜ) (󰆴',' 𝗐 (𝑋↓↑ ∨ ᗜ))+
𝑇↓  = (𝑋↓↓ ∨ ᗜ) (󰆴',' 𝗐 (𝑋↓↓ ∨ ᗜ))+
𝑎↑↑ = 𝑇↑    ∨ ⠶𝑎↓↑
𝑎↑↓ = 𝑇↓    ∨ ⠶𝑎↓↓
𝑎↓↑ = slice ∨ ⠶𝑎↓↓
𝑎↓↓ = (grp ∨ 𝑃 ∨ 𝐿 ∨ ⠶𝔸𝕂 ∨ ⠶str ∨ native_code ∨ ugx_x
           ∨ ¬lamb_h_implicit lamb ∨ 𝑣_spec ∨ op
           ∨ number_exp ∨ number ∨ ⠶script ∨ 𝑣)

𝔸𝕂 = (𝔸 = 󰆴'⠤' 𝖶 𝑋↓↑) ∨ (𝕂 = 󰆴'⠶' 𝖶 𝑋↓↑)
slice = (𝑋↓↓ ∨ ᗜ) (󰆴':' 𝗐 (𝑋↓↓ ∨ ᗜ))+

native_code = 󰆴'⦃' (~‹[^⦃⦄␛␛]+› ∨ 󰆴"␛␛" ~‹.› ∨ 󰆴'⦃' 𝖶 𝑋↑↑? 𝖶 󰆴'⦄' )* 󰆴'⦄'
native_imp = ((native_imp_from   = (󰆴'⮌' 𝗐 ~‹[^ \t\n⨡]+› 𝗐))?
              (native_imp_fields = (󰆴'⨡' 𝗐 native_imp_targ (󰆴',' 𝗐 native_imp_targ)* )))
native_imp_targ = ~‹[^ \t\n:,]+› (𝗐 󰆴':' 𝗐 ~‹[^ \t\n,]+›)? 𝗐

pos_num = ƨ(~‹0([bB][01]+|[oO][0-7]+|[xX][0-9a-fA-F]+)|([0-9]+(\.[0-9]*)?|[0-9]*\.[0-9]+)(e[+\-]?[0-9]+)?›)
neg_num = ƨ(~‹󷰽([󷱈󷱐][󷰽󷰾]+|[󷱍󷱕][󷰽-󷱄]+|[󷱎󷱖][󷰽-󷱆󷱇-󷱌󷱏-󷱔]+)|([󷰽-󷱆]+(\.[󷰽-󷱆]*)?|[󷰽-󷱆]*\.[󷰽-󷱆]+)(󷱋[+\-]?[󷰽-󷱆]+)?›)
number     = pos_num ∨ neg_num
number_exp = number sup
script = ( (sub = 󰆴SB 𝖶 𝑋↑↑ 𝖶 󰆴SE)
          ∨(sup = 󰆴SP 𝖶 𝑋↑↑ 𝖶 󰆴SE))
grp = ~‹[{⁅⟦]› 𝖶 (𝑋↑↑ ∨ ✓) 𝖶 ~‹[}⁆⟧]›

op = op_⸓_l op_lit op_⸓_r
op⸓l_g = ⠶op_⸓_ly (⠶sup ∨ ✓)
op⸓r_g = ⠶op_⸓_ry (⠶sup ∨ ✓)
op_⸓_l = (⮞(op_⸓_ln ∨ op_⸓_ly) ((op_⸓_ln ∨ op⸓l_g ∨ 𝚜) 𝗐)*)?
op_⸓_r =                       ((op_⸓_rn ∨ op⸓r_g ∨ 𝚜) 𝗐)*
𝚜 = ⠶sup

𝑣𝕒 = 𝑣 ∨ op_lit 󰆴'´'?
𝑣 = (󰆴'´' ↷ ~‹[^´]+›) ∨ ƨ((¬𝑣_bad ~‹.›)+)
𝑣_bad = (𝗪 ∨ ~‹󰦥{5}|[;:,=⍈󷸴⍮⟥⟤⭡⭣𝗮-𝘇𝟬-𝟵󷺗ᐸᐳᑅᑀᐘᐒᑈᐵᐛᐖ󷺹-󷻀⥌↦𝚲󰲟󰲡󰲣󰲥󰲧󰲩󰲫󰲭󰲯󰲱󰅂$"'\[\](){}⁅⁆⟦⟧⟨⟩⦃⦄󰜞󰜚󰜛‹ ␛␛␛›]›
           ∨ op_⸓_ln ∨ op_⸓_ly ∨ op_lit ∨ script ∨ 𝑣_spec ∨ std_kwd ∨ blk_cln_kwd ∨ blk_kwd)

W_L = (‹⟥›∨✓) ~‹[ᐳᑀᐒᐵᐖ󷺹󷺻󷺺󷺼]›
W_R =         ~‹[ᐸᑅᐘᑈᐛ󷺽󷺿󷺾󷻀]› (‹⟤›∨✓)

str = empty_str ∨ str_tsys ∨ ((str_t󰦥 ∨ str_tsub ∨ str_nsub ∨ ⠶str_gen_inner) 𝗐)+
str_t󰦥   = 󰆴(~‹󰦥{5}›) ~‹((?!󰦥{5})(.|\n))*› 󰆴(~‹󰦥{5}› ∨ ✓)
str_tsys = 󰆴'$' 𝗐 (ƨ(sup) ∨ ✓) 𝗐 (⠶str_sub_inner ∨ str_tsys_guts)* 𝗐 󰆴'󷹹'
str_tsub = 󰆴'‹'                  (⠶str_sub_inner ∨ str_tsub_guts)*   󰆴'›'
str_tsys_guts = ~‹[^𝗮-𝘇𝟬-𝟵󷺗␛␛⟦󷹹]+› 
str_tsub_guts = ~‹[^𝗮-𝘇𝟬-𝟵󷺗␛␛⟦␛›]+›
str_nsub = ⠶(str_nsub1 ∨ str_nsub2)
str_nsub1 = 󰆴‹"› ↷ (⠶str_gen_inner ∨ (str_nsub1_guts = ~‹[^𝗮-𝘇𝟬-𝟵󷺗␛␛"]+›))*
str_nsub2 = 󰆴‹'› ↷ (⠶str_gen_inner ∨ (str_nsub2_guts = ~‹[^𝗮-𝘇𝟬-𝟵󷺗␛␛']+›))*

str_nodelim = str_escape ∨ str_spec_char
empty_str = 󰆴'󷺗' ""
str_sub_inner = ⠶str_gen_inner ∨ str_sub
str_gen_inner = (str_escape ∨ 󰆴'󷺗' ∨ str_spec_char)+
str_sub = 󰆴'⟦' 𝑋↑↑ 󰆴'⟧'
str_spec_char = ~‹[𝟬-𝟵𝗮-𝗳]{2}|[𝗮-𝘇󷺗]›
str_escape = 󰆴"␛␛" ~‹.›
str_guts = ~‹[^𝗮-𝘇𝟬-𝟵󷺗⟦␛␛␛›'"󷹹]+›

ugx_x     = ⮞ugx_brack ugx_brack
ugx_mod   = 󰆴SP ~‹[􊽨⁺􋅋􊽬]› 󰆴SE
ugx_and   = ⠶ugx_atom+
ugx_or    = ugx_and 󰆴'󷸴' 𝖶 (⠶ugx_or ∨ ugx_and)
ugx_☾     = 𝑋↑↑ 󰆴'⍮'? (mod:ugx_mod)?
ugx_seq   = ((ugx_or ∨ ⠶ugx_atom) 𝖶)+ (apply:(󰆴'⍈' 𝖶 𝑋↑↑))?
ugx_atom  = (ugx_group ∨ ugx_☾    ) 𝖶
ugx_group = (ugx_paren ∨ ugx_brack)
ugx_gtail = (mod:(𝖶 ∧ ugx_mod))? (𝗐 ∧ stk:sub)?
ugx_paren = 󰆴'(' 𝖶 ⠶ugx_seq 󰆴')' ⠶ugx_gtail
ugx_brack = 󰆴'⟨' 𝖶 ⠶ugx_seq 󰆴'⟩' ⠶ugx_gtail

ᗜ = 𝗐 ''
𝘄 = 󰆴(~‹(␛␛\n|[ \t])+›  )
𝗪 = 󰆴(~‹(␛␛\n|[ \t\n])+›)
comment = ~‹((|#)[^\n]*(?=\n|\Z))|(🟑[^🟑]*(🟑|\Z))|(֎[^֎]*(֎|\Z))›