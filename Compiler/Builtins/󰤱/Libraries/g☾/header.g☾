#version 330 core
out 𝟜 FragColor;
in 𝟛 pos;

#define τ 6.28318530718
#define π 3.14159265359
#define 󷺍 1.57079632679

𝟙 min2(𝟚 v) ⇒↪ ⤈(vˣ,vʸ);
𝟙 max2(𝟚 v) ⇒↪ ⤉(vˣ,vʸ);
𝟙 min3(𝟛 v) ⇒↪ ⤈(⤈(vˣ,vʸ),vᶻ);
𝟙 max3(𝟛 v) ⇒↪ ⤉(⤉(vˣ,vʸ),vᶻ);
𝟙 min4(𝟜 v) ⇒↪ ⤈(⤈(vˣ,vʸ),⤈(vᶻ,vʷ));
𝟙 max4(𝟜 v) ⇒↪ ⤉(⤉(vˣ,vʸ),⤉(vᶻ,vʷ));

𝟙 sq(𝟙 x) ⇒↪ x⋅x;
𝟙 pws(𝟙 x,𝟙 y) ⇒↪ ⴵ(x)⋅pow(⫰(x),y); 
𝟙 smoo(𝟙 x, 𝟙 y) ⇒↪ (exp(y⋅󷹄(x,0,1))-1)÷(exp(y)-1); 

𝟛 rgb2hsv(𝟛 c) ⇒
    𝟜 K = 𝟜(0, -⅓, ⅔, 󷰾);
    𝟜 p = mix(𝟜(cᵇᵍ, Kʷᶻ), 𝟜(cᵍᵇ, Kˣʸ), step(cᵇ, cᵍ));
    𝟜 q = mix(𝟜(pˣʸʷ, cʳ), 𝟜(cʳ, pʸᶻˣ), step(pˣ, cʳ));
    𝟙 d = qˣ - ⤈(qʷ,qʸ);
    𝟙 e = 1.0e-10;
    ↪ 𝟛(⫰(qᶻ+(qʷ-qʸ) ÷ (6⋅d+e)), d÷(qˣ+e), qˣ);
𝟛 hsv2rgb(𝟛 c) ⇒
    𝟜 K = 𝟜(1, ⅔, ⅓, 3);
    𝟛 p = ⫰(6⋅fract(cˣˣˣ + Kˣʸᶻ) - Kʷʷʷ);
    ↪ cᶻ ⋅ mix(Kˣˣˣ, p - Kˣˣˣ, cʸ);

𝟛 θXY(𝟛 p,𝟙 r) ⇒↪ 𝟛(pˣ⋅􋐳(r)-pʸ⋅􋐲(r),pˣ⋅􋐲(r)+pʸ⋅􋐳(r),pᶻ);
𝟛 θXZ(𝟛 p,𝟙 r) ⇒↪ 𝟛(pˣ⋅􋐳(r)-pᶻ⋅􋐲(r),pʸ,pˣ⋅􋐲(r)+pᶻ⋅􋐳(r));
𝟛 θYZ(𝟛 p,𝟙 r) ⇒↪ 𝟛(pˣ,pʸ⋅􋐳(r)-pᶻ⋅􋐲(r),pʸ⋅􋐲(r)+pᶻ⋅􋐳(r));
𝟛 θXZYZ  (𝟛 p, 𝟚 θ) ⇒↪ θXZ(θYZ(p, θˣ), θʸ);
𝟛 θXZYZ_i(𝟛 p, 𝟚 θ) ⇒↪ θYZ(θXZ(p,¯θˣ),¯θʸ);