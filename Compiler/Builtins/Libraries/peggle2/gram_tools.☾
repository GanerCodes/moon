    ∀r∈󱁕.find(󷺹ᵉ∋␛R,✓,✗): δ.append((rᵉ ᵖ₀,+r⭢🃌 ))
    ∀r∈󱁕.find(󷺹ᵉ∋␛I,✓,✗): δ.append((rᵉ ᵖ₁,+r⭢🃌󷹒))
    󱁕.rm(󷺹ᵉ ⁻∩␛R␛Iᐸ)
    ↪ +󱁕,gram_surgery(⬤,δ)

