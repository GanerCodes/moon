op_⸓_ln     = ~‹%OP_MOD_L_N%›
op_⸓_ly     = ~‹%OP_MOD_L_Y%›
op_⸓_rn     = ~‹%OP_MOD_R_N%›
op_⸓_ry     = ~‹%OP_MOD_R_Y%›
op_lit      = ~‹%OP_LIT%›
𝑉_spec      = ~‹%VAR_SPEC%›
    std_kwd = ~‹%STD_KWDS%›
blk_cln_kwd = ~‹%BLK_CLN_KWDS%›
    blk_kwd = ~‹%BLK_KWDS%›

SB='󰜞'
SP='󰜚'
SE='󰜛'

parse_main = stmts?
parse_comm = (⠶(str ∨ native_code) ∨ 󰆴comment ∨ ~‹.|\n›)*

stmts   = (stmt ∨ 𝗪 ∨ 󰆴';')+
multi_x = 𝗪? (⠶norm_x 𝗪?)+

stmt = native_imp ∨ blk_head ∨ kwd_std ∨ asgn ∨ norm_x

blk_head = ⊢_dec ∨ cln_pfx ∨ std_pfx
⊢_dec    = 󰆴'⊢' 𝗪? (wrap=(grp 𝗪? ∨ ✓)) (𝑉 ∨ (op_lit 󰆴'´'?) ∨ ✓) 𝘄? (𝑡_par ∨ ✓) 𝗪? 󰆴(')' 𝗪? ':' 𝘄?)
kwd_std  =     std_kwd 𝘄? (norm_x    ∨ ✓)
cln_pfx  = blk_cln_kwd 𝗪? (x_not_cln ∨ ✓) 𝗪? 󰆴':' 𝘄?
std_pfx  =     blk_kwd 𝘄?

𝑙 = 󰆴'[' ⠶𝑡_guts 󰆴']' ∨ 󰆴SB ⠶𝑡_guts 󰆴SE

χ   = (¬(',' ∨ '=') (whiskers ∨ ⠶x_slice) 𝘄?)+
χ_λ = (¬(',' ∨ '=') (¬lamb_h_implicit lamb ∨ whiskers ∨ ⠶x_slice) 𝘄?)+

asgn = 𝑡_gutsneq 𝘄? 󰆴'=' 𝘄? (asgn ∨ norm_x)

norm_x      = ((money ∨ x_slice ∨ ⠶x_nolla) 𝘄?)+
𝑡_par       = 󰆴'(' ⠶𝑡_guts 󰆴')'
𝑡_guts      = (⠶𝑡_parv    ∨ 𝗪?)*
𝑡_gutsneq   = (⠶𝑡_parvneq ∨ 𝗪?)*
𝑡_imp       = x_slice? 𝘄? ',' (',' ∨ x_slice ∨ 𝘄)*
𝑡_parv      = 𝑡_named_val ∨ ⠶𝑡_parvneq
𝑡_parvneq   = ⠶𝔸𝕂 ∨ ⠶x_slice
𝑡_named_val = ⠶(𝑉_named = 𝑉 ∨ op_lit) 𝗪? 󰆴'=' 𝗪? x_slice
x_slice = ((slice ∨ ⠶x_nolla) 𝘄?)+
slice   = x_nolla? 𝘄? ':' (':' ∨ x_nolla ∨ 𝘄)*
x_nolla     = (¬(',' ∨ ':') ⠶bruh_x_atom)+
x_not_cln   = (¬(      ':') ⠶rard_x_atom)+
norm_x_atom = (  slice 𝘄? ∨ ⠶rard_x_atom)
rard_x_atom = ( ⠶lambs    ∨ ⠶bruh_x_atom) 𝘄?
bruh_x_atom = grp ∨ 𝑡_e ∨ 𝑙 ∨ ⠶𝔸𝕂 ∨ ⠶str ∨ native_code ∨ ugx_x ∨ 𝑉_spec ∨ op ∨ number_exp ∨ number ∨ ⠶script ∨ 𝑉

𝔸𝕂 = (𝔸 = 󰆴'⠤' 𝗪? ⠶x_slice) ∨ (𝕂 = 󰆴'⠶' 𝗪? ⠶x_slice)
native_code = 󰆴'⦃' (~‹[^⦃⦄␛␛]+› ∨ 󰆴"␛␛" ~‹.› ∨ (󰆴'⦃' 𝗪? multi_x? 𝗪? 󰆴'⦄') )* 󰆴'⦄'
native_imp = ((native_imp_from   = (󰆴'⮌' 𝘄? ~‹[^ \t\n⨡]+› 𝘄?))?
              (native_imp_fields = (󰆴'⨡' 𝘄? native_imp_targ (󰆴',' 𝘄? native_imp_targ)* )))
native_imp_targ = ~‹[^ \t\n:,]+› (𝘄? 󰆴':' 𝘄? ~‹[^ \t\n,]+›)? 𝘄?

pos_num = ƨ(~‹0([bB][01]+|[oO][0-7]+|[xX][0-9a-fA-F]+)|([0-9]+(\.[0-9]*)?|[0-9]*\.[0-9]+)(e[+\-]?[0-9]+)?›)
neg_num = ƨ(~‹󷰽([󷱈󷱐][󷰽󷰾]+|[󷱍󷱕][󷰽-󷱄]+|[󷱎󷱖][󷰽-󷱆󷱇-󷱌󷱏-󷱔]+)|([󷰽-󷱆]+(\.[󷰽-󷱆]*)?|[󷰽-󷱆]*\.[󷰽-󷱆]+)(󷱋[+\-]?[󷰽-󷱆]+)?›)
number     = pos_num ∨ neg_num
number_exp = number sup
script = ( (sub = 󰆴SB 𝗪? norm_x 𝗪? 󰆴SE)
          ∨(sup = 󰆴SP 𝗪? norm_x 𝗪? 󰆴SE))
grp = ~‹[{⁅⟦]› 𝗪? (multi_x ∨ ✓) 𝗪? ~‹[}⁆⟧]›

𝑉_bad = (𝗪 ∨ ~‹󰦥{5}|[;:,=⍈󷸴⍮⟥⟤⭡⭣𝗮-𝘇𝟬-𝟵󷺗ᐸᐳᑅᑀᐘᐒᑈᐵᐛᐖ󷺹-󷻀⥌↦𝚲󰲟󰲡󰲣󰲥󰲧󰲩󰲫󰲭󰲯󰲱󰅂$"'\[\](){}⁅⁆⟦⟧⟨⟩⦃⦄󰜞󰜚󰜛‹ ␛␛␛›]›
           ∨ op_⸓_ln ∨ op_⸓_ly ∨ op_lit ∨ script ∨ 𝑉_spec ∨ std_kwd ∨ blk_cln_kwd ∨ blk_kwd)
𝑉 = 󰆴'´' ~‹[^´]+› 󰆴'´' ∨ ƨ((¬𝑉_bad ~‹.›)+)

op = op_⸓_l op_lit op_⸓_r
op⸓l_g = ⠶op_⸓_ly (⠶sup ∨ ✓)
op⸓r_g = ⠶op_⸓_ry (⠶sup ∨ ✓)
op_⸓_l = (⮞(op_⸓_ln ∨ op_⸓_ly) ((op_⸓_ln ∨ op⸓l_g ∨ 𝚜) 𝘄?)*)?
op_⸓_r =                       ((op_⸓_rn ∨ op⸓r_g ∨ 𝚜) 𝘄?)*
𝚜 = ⠶sup

lambs = (  (whiskers=(    (⠶LTL (norm_x    ∨ ✓) ⠶LTR)
                        ∨ (⠶LTL (x_slice ∨ ✓) ✓ ✓)))
         ∨ (lamb    =((   (󰆴'⥌' 𝗪? (𝑡_guts ∨ ✓) 𝗪? 󰆴'↦')
                        ∨ (lamb_h_preset   = ~‹[𝚲󰲟󰲡󰲣󰲥󰲧󰲩󰲫󰲭󰲯󰲱]›)
                        ∨ (lamb_h_implicit = ⠶𝑉 𝗪? 󰆴'↦'    ))
                      𝗪? (norm_x 󰆴'󰅂' ∨ x_slice))))

LTL = (‹⟥›∨✓) ~‹[ᐳᑀᐒᐵᐖ󷺹󷺻󷺺󷺼]› 𝗪?
LTR = ~‹[ᐸᑅᐘᑈᐛ󷺽󷺿󷺾󷻀]› (‹⟤›∨✓)

str = empty_str ∨ str_tsys ∨ ((str_t󰦥 ∨ str_tsub ∨ str_nsub ∨ ⠶str_gen_inner) 𝘄?)+
str_t󰦥   = (󰆴(~‹󰦥{5}›)) ~‹((?!󰦥{5})(.|\n))*› 󰆴((~‹󰦥{5}›) ∨ ✓)
str_tsys = 󰆴'$' 𝘄? (ƨ(sup) ∨ ✓) 𝘄? (
                                (⠶str_sub_inner ∨ ( str_tsys_guts=~‹[^𝗮-𝘇𝟬-𝟵󷺗␛␛⟦󷹹]+› ))* 𝘄? 󰆴'󷹹')
str_tsub = 󰆴'‹'                ((⠶str_sub_inner ∨ ( str_tsub_guts=~‹[^𝗮-𝘇𝟬-𝟵󷺗␛␛⟦␛›]+›))* 󰆴'›'     )
str_nsub = ⠶(  (str_nsub1=(󰆴‹"› (⠶str_gen_inner ∨ (str_nsub1_guts=~‹[^𝗮-𝘇𝟬-𝟵󷺗␛␛"]+›))* 󰆴‹"›))
             ∨ (str_nsub2=(󰆴‹'› (⠶str_gen_inner ∨ (str_nsub2_guts=~‹[^𝗮-𝘇𝟬-𝟵󷺗␛␛']+›))* 󰆴‹'›)))

str_nodelim = str_escape ∨ str_spec_char
empty_str = 󰆴'󷺗' ""

str_sub_inner = ⠶str_gen_inner ∨ str_sub
str_gen_inner = (str_escape ∨ 󰆴'󷺗' ∨ str_spec_char)+
str_sub = 󰆴'⟦' norm_x 󰆴'⟧'
str_spec_char = ~‹[𝟬-𝟵𝗮-𝗳]{2}|[𝗮-𝘇󷺗]›
str_escape = 󰆴"␛␛" ~‹.›
str_guts = ~‹[^𝗮-𝘇𝟬-𝟵󷺗⟦␛␛␛›'"󷹹]+›

ugx_x  = ⮞ugx_brack ugx_brack
ugx_mod   = 󰆴SP ~‹[􊽨⁺􋅋􊽬]› 󰆴SE
ugx_and   = ⠶ugx_atom+
ugx_or    = ugx_and 󰆴'󷸴' 𝗪? (⠶ugx_or ∨ ugx_and)
ugx_☾     = multi_x 󰆴'⍮'? (mod:ugx_mod)?
ugx_seq   = ((ugx_or ∨ ⠶ugx_atom) 𝗪?)+ (apply:(󰆴'⍈' 𝗪? multi_x))?
ugx_atom  = (ugx_group ∨ ugx_☾    ) 𝗪?
ugx_group = (ugx_paren ∨ ugx_brack)
ugx_gtail = (mod:(𝗪? ∧ ugx_mod))? (𝘄? ∧ stk:sub)?
ugx_paren = 󰆴'(' 𝗪? ⠶ugx_seq 󰆴')' ⠶ugx_gtail
ugx_brack = 󰆴'⟨' 𝗪? ⠶ugx_seq 󰆴'⟩' ⠶ugx_gtail

𝘄 = 󰆴(~‹(␛␛\n|[ \t])+›  )
𝗪 = 󰆴(~‹(␛␛\n|[ \t\n])+›)

comment = ~‹((|#)[^\n]*(?=\n|\Z))|(🟑[^🟑]*(🟑|\Z))|(֎[^֎]*(֎|\Z))›