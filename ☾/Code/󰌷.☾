𝑰 = 𝗜

⊢ adjust_depth(𝚡,s,𝑰=𝗜):  negative depth
    ¿s≅␀: ↪1
    ¿s≥0: ↪s
    𝚡,k = 𝚡,0
    ➰𝑰(𝚡)⭜k󷸊+1:
        ¿𝚡ᐹᔐ: ⇥
        𝚡󷸊₀
    ↪ s+k-1⭢⤉0
⊢ flatten(𝚡,s=␀,𝙻=□,𝑰=𝗜):  flatten with depth s
    s = adjust_depth(𝚡,s)
    ¿𝙻≅□: 𝙻=⍁
    ¿s≤0∨¬𝑰(𝚡)∨ᔐᐴ𝚡:
        ↪(𝑰(𝚡)⭜𝙻.extend⭝𝙻.append)(𝚡)►𝙻
    ∀x∈𝚡:flatten(x,s-1,𝙻,𝑰=𝑰)
    ↪ 𝙻
⊢ chain_structure(𝚡,s=␀,𝑰=𝗜):  replace all vals with □
    s = adjust_depth(𝚡,s)
    ¿s≤0∨¬𝑰(𝚡)∨ᔐᐴ𝚡: ↪𝑰(𝚡)⭜□⛶􀳉􋌵⭝□
    ↪ 𝚡ᴍchain_structure(⬤,s-1,𝑰=𝑰)
⊢ deflatten(𝚡,𝙸,𝑰=𝗜):  deflatten(x, chain_structure(𝚡)) ≈ 󰻾
    ¿𝙸≅□: ↪𝚡 ⭜𝚡.pop(0)⭝ 󰮈
    ↪ 𝙸ᴍdeflatten(𝚡,⬤,𝑰=𝑰)
⊢ flatten_under(𝚡,ƒ,s=␀,𝘪=␀,𝑰=𝗜):  flatten, change, reshape back
    s = adjust_depth(𝚡,s)
    𝘪 = 𝘪≅␀ ⭜flatten(𝚡,s,𝑰=𝑰)⭝ 𝘪
    ↪ deflatten(ƒ(𝘪), chain_structure(𝚡,s,𝑰=𝑰))

