⊢ create_precedences(tiers, specials, ƒ=󰻾):
    𝐎 = {}
    ∀tier ∈ tiersᴙ:
        𝐶 = 𝑠←𝐎.keys
        T = 𝑠←tierᐵ₀
        ∀𝓽,𝓶 ∈ tier:
            𝐶 = 𝐶.copy
            ¿␛I∈𝓶: 𝐶 ∪= T
            
            𝐾 = {}
            ¿𝓶∩"BS": 𝐾􊯛󰂞 = 𝐶.copy()
            ¿𝓶∩"BP": 𝐾􊯛󰂤 = 𝐶.copy()
            𝐎􋚾 = OP(𝓽, 𝓶, ⠶𝐾)≕𝐨 ◄ (𝐨ᶠ≔make_op_call(𝐨))
    
    𝐍 = {}
    ∀L,(𝓽,𝓶),R ∈ specials:
        L_c = L ⭜𝐎󰂞ᴸ∪𝐎󰂞ᴿ⭝ {}
        R_c = R ⭜𝐎󰂤ᴸ∪𝐎󰂤ᴿ⭝ {}
        ∀c∈𝐎:
            ¿c∉L_c ∧ (O≔𝐎)ᴾᴮ: Oᴿ ∪= {𝓽}
            ¿c∉R_c ∧ (O≔𝐎)ᴾᴮ: Oᴸ ∪= {𝓽}
        
        𝐾 = {}
        ¿L: 𝐾􊯛󰂞 = 𝐎.keys∖𝐎󰂞ᴸ ∪ {L}
        ¿R: 𝐾􊯛󰂤 = 𝐎󰂤ᴿ
        𝐍􋚾 = (OP(𝓽, 𝓶, ⠶𝐾)≕𝐨)◄(𝐨ᶠ≔make_op_call(𝐨))
    𝐎 |= 𝐍
    
    ↪ ƒ∘𝐎

