{ "name"      : "moon",
  "scopeName" : "source.moon",
  "patterns"  : [{ "include": "#gen" }],
  "repository": {
    "syms"      : { "patterns": [] },
    
    "gen"       : { "patterns": [{ "include": "#com"  },
                                 { "include": "#str"  },
                                 { "include": "#syms" }] },
    
    "com"       : { "patterns": [{ "include": "#com_ln" },
                                 { "include": "#com_il" }] },
    
    "com_ln"    : { "name" : "comment.ln.moon",
                    "match": ".*"},
    
    "com_il"    : { "name" : "comment.il.moon",
                    "begin": "🟑",
                    "end"  : "🟑",
                    "beginCaptures": { "0": { "name": "punctuation.ilinecom.moon" }},
                    "endCaptures"  : { "0": { "name": "punctuation.ilinecom.moon" }} },
    
    "str"       : { "patterns": [{"include": "#str_star" },
                                 {"include": "#str_sys"  },
                                 {"include": "#str_sub"  },
                                 {"include": "#str_nsub1"},
                                 {"include": "#str_nsub2"},
                                 {"include": "#str_atom" }] },
    
    "str_star" : { "name"    : "string.star.moon",
                   "begin"   : "󰦥{5}",
                   "end"     : "󰦥{5}",
                   "beginCaptures": { "0": { "name": "punctuation.str.moon" }},
                   "endCaptures"  : { "0": { "name": "punctuation.str.moon" }} },
    
    "str_sys"  : { "name"    : "string.sys.moon",
                   "begin"   : "\\$",
                   "end"     : "󷹹",
                   "beginCaptures": { "0": { "name": "punctuation.str.moon" }},
                   "endCaptures"  : { "0": { "name": "punctuation.str.moon" }},
                   "patterns": [{ "include": "#str_atom" }] },
    
    "str_sub"  : { "name"    : "string.sub.moon",
                   "begin"   : "‹",
                   "end"     : "›",
                   "beginCaptures": { "0": { "name": "punctuation.str.moon" }},
                   "endCaptures"  : { "0": { "name": "punctuation.str.moon" }},
                   "patterns": [{ "include": "#str_atom" }] },
    
    "str_nsub1": { "name"    : "string.nsub1.moon",
                   "begin"   : "\"",
                   "end"     : "\"",
                   "beginCaptures": { "0": { "name": "punctuation.str.moon" }},
                   "endCaptures"  : { "0": { "name": "punctuation.str.moon" }},
                   "patterns": [{ "include": "#str_esc"  },
                                { "include": "#spec_char"}] },
    
    "str_nsub2": { "name"    : "string.nsub2.moon",
                   "begin"   : "'",
                   "end"     : "'",
                   "patterns": [{ "include": "#str_esc"  },
                                { "include": "#spec_char"}] },
    
    "str_atom" : { "patterns": [{ "include": "#embed"    },
                                { "include": "#str_esc"  },
                                { "include": "#spec_char"}] },
    
    "embed"    : { "name"         : "source.moon",
                   "begin"        : "⟦",
                   "end"          : "⟧",
                   "beginCaptures": { "0": { "name": "punctuation.strsub.moon" }},
                   "endCaptures"  : { "0": { "name": "punctuation.strsub.moon" }},
                   "patterns"     : [{ "include": "#gen" }] },
    
    "spec_char": { "name"         : "string.spec_char.moon",
                   "match"        : "[󷺗𝗮-𝘇𝟬-𝟵]" },
    
    "str_esc"  : { "name"         : "string.escwhole.moon",
                   "begin"        : "␛",
                   "end"          : ".",
                   "beginCaptures": { "0": { "name": "symbol.esc.moon" } } } } }