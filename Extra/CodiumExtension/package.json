{ "name": "moon",
  "displayName": "☾",
  "version": "0.0.1",
  "publisher": "moon",
  "icon": "☾.png",
  "engines": { "vscode": "^1.50.0" },
  "main": "./main.js",
  "activationEvents": ["onLanguage:moon"],
  "contributes": {
    "commands"   : [{ "command": "moon.sup"             , "title": "Supscript"                 },
                    { "command": "moon.nrm"             , "title": "Nrmscript"                 },
                    { "command": "moon.sub"             , "title": "Subscript"                 },
                    { "command": "moon.ord3"            , "title": "Op Order +3"               },
                    { "command": "moon.dro3"            , "title": "Op Order -3"               },
                    { "command": "moon.ord1"            , "title": "Op Order +1"               },
                    { "command": "moon.dro1"            , "title": "Op Order -1"               },
                    { "command": "moon.set0"            , "title": "Op Order 0"                },
                    { "command": "moon.set3"            , "title": "Op Order 3"                },
                    { "command": "moon.set7"            , "title": "Op Order 7"                },
                    { "command": "moon.set9"            , "title": "Op Order 9"                },
                    { "command": "moon.set13"           , "title": "Op Order 13"               },
                    { "command": "moon.set16"           , "title": "Op Order 16"               },
                    { "command": "moon.set19"           , "title": "Op Order 19"               },
                    { "command": "moon.wall"            , "title": "Wall"                      },
                    { "command": "moon.align"           , "title": "Align"                     },
                    { "command": "moon.dirOpener"       , "title": "Dir in term"               },
                    { "command": "moon.fileRun"         , "title": "Run in term"               },
                    { "command": "moon.splitLineKeepCol", "title": "Split line keeping column" }],
    "keybindings": [{ "command": "moon.sup"             , "key": "alt+w"           , "when": "editorTextFocus" },
                    { "command": "moon.nrm"             , "key": "alt+x"           , "when": "editorTextFocus" },
                    { "command": "moon.sub"             , "key": "alt+s"           , "when": "editorTextFocus" },
                    { "command": "moon.ord1"            , "key": "alt+>"           , "when": "editorTextFocus" },
                    { "command": "moon.dro1"            , "key": "alt+<"           , "when": "editorTextFocus" },
                    { "command": "moon.ord3"            , "key": "alt+."           , "when": "editorTextFocus" },
                    { "command": "moon.dro3"            , "key": "alt+,"           , "when": "editorTextFocus" },
                    { "command": "moon.set0"            , "key": "alt+shift+["     , "when": "editorTextFocus" },
                    { "command": "moon.set3"            , "key": "alt+["           , "when": "editorTextFocus" },
                    { "command": "moon.set7"            , "key": "alt+ctrl+shift+1", "when": "editorTextFocus" },
                    { "command": "moon.set9"            , "key": "alt+;"           , "when": "editorTextFocus" },
                    { "command": "moon.set13"           , "key": "alt+ctrl+shift+2", "when": "editorTextFocus" },
                    { "command": "moon.set16"           , "key": "alt+]"           , "when": "editorTextFocus" },
                    { "command": "moon.set19"           , "key": "alt+shift+]"     , "when": "editorTextFocus" },
                    { "command": "moon.wall"            , "key": "ctrl+alt+a"      , "when": "editorTextFocus" },
                    { "command": "moon.align"           , "key": "alt+a"           , "when": "editorTextFocus" },
                    { "command": "moon.splitLineKeepCol", "key": "ctrl+alt+enter"  , "when": "editorTextFocus" },
                    { "command": "moon.dirOpener"       , "key": "ctrl+shift+`"                                },
                    { "command": "moon.fileRun"         , "key": "ctrl+r"                                      }],
    "languages": [{ "id": "moon",
                    "icon": { "dark" : "☾.png", "light": "☾.png" },
                    "aliases": ["☾"],
                    "extensions": [".☾",".cpy"],
                    "configuration": "./☾.conf.json" }],
    "grammars": [{ "language": "moon",
                   "scopeName": "source.moon",
                   "path": "./syntaxes/☾.tmLanguage.json" }],
    "themes": [{ "label": "☾ Theme",
                 "uiTheme": "vs-dark",
                 "path": "./themes/theme.json" }] } }