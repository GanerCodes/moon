{
  "name": "☾",
  "scopeName": "source.☾",
  "patterns": [
    {
      "include": "#str"
    }
  ],
  "repository": {
    "parse_file": {
      "patterns": [
        {
          "include": "#str"
        },
        {
          "match": "[^⟧]",
          "name": "constant.character.special.☾"
        }
      ]
    },
    "str": {
      "patterns": [
        {
          "include": "#str_empty_marker"
        },
        {
          "include": "#str_tsys"
        },
        {
          "include": "#str_cat"
        }
      ]
    },
    "str_cat": {
      "patterns": [
        {
          "include": "#str_tblock"
        },
        {
          "include": "#str_tsub"
        },
        {
          "include": "#str_nsub"
        },
        {
          "include": "#str_gen_inner"
        }
      ]
    },
    "str_tblock": {
      "name": "string.block.t󰦥.☾",
      "begin": "󰦥{5}",
      "end": "󰦥{5}?",
      "patterns": [
        {
          "match": "(?!󰦥{5})(.|\\n)*",
          "name": "string.block.content.☾"
        }
      ]
    },
    "str_tsys": {
      "name": "string.template.sys.☾",
      "begin": "\\$",
      "end": "󷹹",
      "patterns": [
        {
          "include": "#str_sub_inner"
        },
        {
          "match": "[^𝗮-𝘇𝟬-𝟵󷺗␛⟦󷹹]+",
          "name": "string.template.sys.guts.☾"
        }
      ]
    },
    "str_tsub": {
      "name": "string.template.sub.☾",
      "begin": "‹",
      "end": "›",
      "patterns": [
        {
          "include": "#str_sub_inner"
        },
        {
          "match": "[^𝗮-𝘇𝟬-𝟵󷺗␛⟦␛›]+",
          "name": "string.template.sub.guts.☾"
        }
      ]
    },
    "str_nsub": {
      "patterns": [
        {
          "include": "#str_nsub1"
        },
        {
          "include": "#str_nsub2"
        }
      ]
    },
    "str_nsub1": {
      "name": "string.quoted.double.☾",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "include": "#str_gen_inner"
        },
        {
          "match": "[^𝗮-𝘇𝟬-𝟵󷺗␛\"]+",
          "name": "string.guts.double.☾"
        }
      ]
    },
    "str_nsub2": {
      "name": "string.quoted.single.☾",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "include": "#str_gen_inner"
        },
        {
          "match": "[^𝗮-𝘇𝟬-𝟵󷺗␛']+",
          "name": "string.guts.single.☾"
        }
      ]
    },
    "str_empty_marker": {
      "match": "󷺗",
      "name": "constant.language.empty-str.☾"
    },
    "str_sub_inner": {
      "patterns": [
        {
          "include": "#str_gen_inner"
        },
        {
          "include": "#str_sub"
        }
      ]
    },
    "str_gen_inner": {
      "patterns": [
        {
          "include": "#str_escape"
        },
        {
          "include": "#str_empty_marker"
        },
        {
          "include": "#str_spec_char"
        }
      ]
    },
    "str_sub": {
      "name": "meta.bracket.sub.☾",
      "begin": "⟦",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.brackets.begin.☾"
        }
      },
      "end": "⟧",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.brackets.end.☾"
        }
      },
      "patterns": [
        {
          "include": "#parse_file"
        }
      ]
    },
    "str_spec_char": {
      "match": "‹[𝟬-𝟵𝗮-𝗳]{2}|[𝗮-𝘇󷺗]›",
      "name": "constant.character.special.☾"
    },
    "str_escape": {
      "match": "␛.",
      "name": "string.other.single-char.☾"
    }
  }
}