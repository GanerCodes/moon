    root,rule = Rᵀ􋕟ʳᵒᵒᵗ,Rᵣ
    
    ℒ = DEBUG ⭜𝓣⭝ ⴴ
    ℒ ; ℭ = parse(c,root,rule,debug=DEBUG) ; ℒ(‹Parse󷺗󷺗›)
