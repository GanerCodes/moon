  Ѧˢᵉᵗᴺ = ⥌n=Ѧⁿ,i=󱣩,activate=✓↦{
    ⎉ l,r; [l,Ѧⁿ,r] = G(i≅󱣩 ⭜n⭝ G(Ѧⁿ)₀+i);
    [𝚕􋒗,𝚛􋒗] = [Ѧⁿ≡0, Ѧⁿ≡Ѧᴺ-1];
    ∀(©[i,σ]⎔↨(󷸻(l,r))) {
      [𝙱ᵢⁿ,𝙱ᵢ􋒷] = [σ,σ+Ѧᵈ􋕟ᵒᶠᶠ];
