  ↪ə; };

⎉ [𝘥,𝘵] = [␀,␀];
© αoverβ = ⥌α,β,s↦{
  ¿(α≅β ∨ ¬(α∧β)) ↪;
  © [v,A] = [α.attributes.dragItem.value,β.attributes];
  ¿(¬(v≡A.dragItem⸮value ∨ v≡A.dragHold⸮value)) ↪;
  ¿(s) { SAT(β,‹maydrop›,ᐦ);
         ¿(𝘵 ∧ 𝘵≇β) RAT(𝘵,‹maydrop›,ᐦ);
         𝘵 = β; }
  ¡ RAT(β,‹maydrop›,ᐦ); };
© confDrag = ⥌,𝚒↦{
  AEL(,‹dragenter›,⥌𝜺↦αoverβ(𝘥,𝜺ᵗᵃʳᵍᵉᵗ,✓));
  AEL(,‹dragleave›,⥌𝜺↦αoverβ(𝘥,𝜺ᵗᵃʳᵍᵉᵗ,✗));
  AEL(,‹dragover› ,⥌𝜺↦𝜺.preventDefault());
  ↪; };
Ϣ.dragItem = ⥌,𝚒=0,ƒ=swapə↦{
  𝚒 = ᐦ+𝚒;
  SAT(,‹dragItem› ,𝚒     );
  SAT(,‹draggable›,‹true›);
  AEL(,‹dragstart›,⥌𝜺↦{ SAT(,‹dragging›,ᐦ); 𝘥=; });
  AEL(,‹dragend›  ,⥌𝜺↦{ RAT(,‹dragging›  );
                         αoverβ(𝘥,𝘵,✗); 𝘥=␀; });
  AEL(,‹drop›     ,⥌𝜺↦{ 𝜺.preventDefault();
                         ¿(≇𝘵) ↪;
                         ¿(𝘥≅𝘵) ↪;
                         ƒ(𝘥,𝘵); });
  ↪confDrag(,𝚒); };
Ϣ.dragHold = ⥌,𝚒=0,ƒ=󰲣x􍪙(y)↦{
