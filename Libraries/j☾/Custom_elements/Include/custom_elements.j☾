  Ѧᴺ     ??= N;
  Ѧʷ     ??= 1; 
  Ѧᵈ􋕟ᵒᶠᶠ ??= 1;
  Ѧⁿ     ??= n;
  󱀝:ə span {𝐶 pageNumBar} ⟦[
    󱀝:𝚕 button {𝐶 pageNumPrev} ‹←›,
    ⠤𝙱=⭥(⤈(2⋅Ѧʷ+1,Ѧᴺ))􊾡(󰲡󱀝 button {𝐶 pageNumButton}),
    󱀝:𝚛 button {𝐶 pageNumNext} ‹→› ]⟧
  ↨(𝙱)􋅝(󰲣y.onclick=𝚲Ѧˢᵉᵗᴺ(󱣩,x));
