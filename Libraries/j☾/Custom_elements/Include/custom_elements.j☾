  𝚛.onclick = 𝚲Ѧˢᵉᵗᴺ(Ѧⁿ+1);
  © G = ⥌n↦{ © [L,R] = [0,Ѧᴺ-1];
             n = 󷹄(n,0,R);
             ¿(Ѧᴺ≤1+2⋅Ѧʷ) ↪[L,n,R];
             ⎉ [l,r] = [⤉(n-Ѧʷ,L),⤈(n+Ѧʷ,R)];
             ¿(l<L+Ѧʷ) ↪[l, n, ⤈(l+2⋅Ѧʷ,R)];
