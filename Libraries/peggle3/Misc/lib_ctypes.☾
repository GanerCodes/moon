 󷹇 this is an incomplete manual WASM cffi implementation. This was started before I figured out how to get cffi working in WASM

 󰤱 we index unions and structs at different times so they can't resolve eachother by name

 base types: any, ptr, u8, u32
 any: only used as pointer
 structs are padded to u32
 pointers are ⟨type⟩
 ⵌtypeⵌℕ is an array of fixed size 
 [type] is a pointer to an array of unknown size

BASE_SIZES = {u8=1,u32=4,ptr=4,any=4}
GRAM = 󰦥󰦥󰦥󰦥

main       = (dec_alias ∨ dec_union ∨ dec_struct ∨ dec_func ∨ 󰆴(~‹[ \t\n]+›))*
block_body = named_type (󰆴(~‹[ \t]*\n[ \t\n]*›) ⠶block_body ∨ 󰆴(~‹[ \n\t]*›?))
general    = struct ∨ union ∨ arr_static ∨ ptr ∨ arr_ptr ∨ type

struct     = 󰆴('{'𝘄?) ⠶block_body 󰆴(𝘄?'}')
union      = 󰆴('⦑'𝘄?) ⠶block_body 󰆴(𝘄?'⦒')
ptr        = 󰆴('⟨'𝘄?) ⠶general    󰆴(𝘄?'⟩')
arr_ptr    = 󰆴('['𝘄?) ⠶general    󰆴(𝘄?']')
arr_static = 󰆴('ⵌ'𝘄?) ⠶general    󰆴(𝘄?'ⵌ'𝘄?) ~‹[0-9]*›

named_type = ⠶general 󰆴(𝘄?     ) name
dec_alias  = name     󰆴(𝘄?'='𝘄?) name
dec_union  = name     󰆴(𝘄?     ) union
dec_struct = name     󰆴(𝘄?     ) struct
dec_func   = 󰆴('⊢'𝘄?) name 󰆴(𝘄?'('𝘄?) (func_param ∨ '') 󰆴(𝘄?')') (󰆴(𝘄?) func_ret)?
func_param = named_type (󰆴(𝘄?','𝘄?) ⠶func_param)?
func_ret   = 󰆴(𝘄?'→'𝘄?) ⠶general
type       = ⠶name

name = ~‹[^ \t\n,=⊢→ⵌ{}⦑⦒⟨⟩()\[\]]+›
𝘄 = ~‹[ \t]+›

