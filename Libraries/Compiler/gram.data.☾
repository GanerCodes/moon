⭷ GRAM=󰦥󰦥󰦥󰦥󰦥

op_⸓_ln     = ~‹%OP_MOD_L_N%›
op_⸓_ly     = ~‹%OP_MOD_L_Y%›
op_⸓_rn     = ~‹%OP_MOD_R_N%›
op_⸓_ry     = ~‹%OP_MOD_R_Y%›
op_lit      = ~‹%OP_LIT%›
𝑣_spec      = ~‹%VAR_SPEC%›
    std_kwd = ~‹%STD_KWDS%›
blk_cln_kwd = ~‹%BLK_CLN_KWDS%›
    blk_kwd = ~‹%BLK_KWDS%›

main = gram_%M%

gram_main = stmts ∨ 𝖶
gram_comm = (⠶(str ∨ native_code) ∨ comment ∨ ~‹.|\n›)*
gram_scrp = ((σscript = (σsup=~‹%SUP%+›)∨(σsub=~‹%SUB%+›)) ∨ sys_call_stupid_script_hack ∨ str ∨ ~‹.|\n›)*

stmts = (stmt ∨ 𝗪 ∨ 󰆴';')+
stmt  = blk_head ∨ kwd_std ∨ asgn ∨ 𝑋𝐶

𝑋𝐶 = comp_∀ ∨ ⠶𝑋↑↑

blk_head = ⊢_dec ∨ cln_pfx ∨ std_pfx ∨ stmt_∀
stmt_∀ =     󰆴'∀'𝖶 (𝑋↑↑ 󰆴'⬠'𝖶 𝑋↑↓ ∨ ✓ 𝑋↑↓ ∨ ✓ ✓) 𝖶 (󰆴'¿'𝖶 𝑋↑↓ ∨ ✓) 󰆴':'
comp_∀ = 𝑋↑↑ 󰆴'∀'𝖶  𝑋↑↑ 󰆴'⬠'𝖶 𝑋↑↑                  (󰆴'¿'𝖶 𝑋↑↑ ∨ ✓)
⊢_dec    = 󰆴'⊢' 𝖶 (wrap = ⠶𝑃 𝖶 ∨ ✓) (𝑣 ∨ op_lit ∨ ✓) 𝖶 (𝑃 ∨ ✓) 𝖶 󰆴':'
kwd_std  = std_kwd 𝗐 (𝑋↑↑ ∨ ✓)
cln_pfx  = (  ⮞'¡' blk_cln_kwd 𝖶 ((𝑣 ∨ 𝑣_spec ∨ op_lit) 𝖶 󰆴'=' 𝖶 𝑋↑↓ ∨ 𝑋↑↓ ∨ ✓)
            ∨      blk_cln_kwd 𝖶 (                                     𝑋↑↓ ∨ ✓)) 𝖶 󰆴':'
std_pfx  =     blk_kwd 𝖶
asgn     = 𝑋↑↑ 𝖶 󰆴'='𝗐 (asgn ∨ 𝑋↑↑)
grp      = ~"[⁅⟦]" (⠶𝑝𝑐 ∨ 𝖶) ~"[⁆⟧]"
𝐿 = 󰆴'[' (⠶𝑝𝑐 ∨ 𝖶) 󰆴']' ∨ 󰆴󰜞 (⠶𝑝𝑐 ∨ 𝖶) 󰆴󰜛
𝑃 = 󰆴'(' (⠶𝑝𝑐 ∨ 𝖶) 󰆴')'
𝑆 = 󰆴'⦉' (⠶𝑝𝑐 ∨ 𝖶) 󰆴'⦊'
𝐷 = 󰆴'{' (𝖶 ⠶𝐷_item (󰆴',' 𝖶 ⠶𝐷_item)* (󰆴',' 𝖶)? ∨ 𝖶) 󰆴'}'
𝐷_item   = 𝐷_kv_nam ∨ 𝐷_kv_nrm ∨ ⠶𝔸𝕂 𝖶
𝐷_kv_nam = (𝑣 ∨ op_lit ∨ ⠶str) 𝖶 󰆴'=' 𝖶 𝑋↓↑ 𝖶
𝐷_kv_nrm =  𝑋↓↓ 𝖶 󰆴':' 𝖶 𝑋↓↑ 𝖶

𝑝𝑐 = 𝖶 comp_∀ 𝖶 ∨ (𝖶 ⠶𝑎𝑝𝑐 𝖶 (󰆴',' 𝖶 (⠶𝑎𝑝𝑐 ∨ ᗜ) 𝖶)*)
𝑎𝑝𝑐 = (kw_𝕒 = 𝑣 𝖶 󰆴'=' 𝖶 ⠶𝑎𝑝𝑐) ∨ 𝑋↓↑
𝑋↑↑ = (𝑇↑ = (𝑋↓↑ ∨ ᗜ) (󰆴',' 𝗐 (𝑋↓↑ ∨ ᗜ))+) ∨ (⠶𝑋↓↑ 𝗐)+
𝑋↑↓ = (𝑇↓ = (𝑋↓↓ ∨ ᗜ) (󰆴',' 𝗐 (𝑋↓↓ ∨ ᗜ))+) ∨ (⠶𝑋↓↓ 𝗐)+
𝑋↓↑ = (⠶𝑎↓↑ 𝗐)+
𝑋↓↓ = (⠶𝑎↓↓ 𝗐)+
𝑎↓↑ = slice ∨ ⠶𝑎↓↓
𝑎↓↓ = (%I% grp ∨ 𝑃 ∨ 𝐿 ∨ 𝐷 ∨ 𝑆 ∨ ⠶script ∨ ⠶𝔸𝕂 ∨ ⠶str ∨ sys_call ∨ native_code
       ∨ import ∨ export ∨ ugx_x ∨ ⠶lambs ∨ op ∨ number_exp ∨ number
       ∨ 𝑣_spec ∨ 𝑣)

𝝀𝑃 = ⠶𝝀𝕒 𝖶 (󰆴',' 𝖶 ⠶𝝀𝕒 𝖶)*
𝝀𝕒 = 𝝀eq ∨ ⠶𝝀𝑎
𝝀𝑎 = ((¬lamb_h_implicit ¬𝔸𝕂 ⠶𝑎↓↑ ∨ ⠶𝝀𝔸𝕂 ∨ 𝑣) 𝗐)+
𝝀eq = 𝑣 𝖶 󰆴'=' 𝖶 𝝀𝑎
𝝀𝔸𝕂 = (𝝀𝔸 = 󰆴'⠤' 𝖶 𝑣) ∨ (𝝀𝕂 = 󰆴'⠶' 𝖶 𝑣)
lambs = (  (whiskers=(    (⠶W_L 𝖶 (𝑋𝐶  ∨ ✓) ⠶W_R)
                        ∨ (⠶W_L 𝖶 (𝑋↓↑ ∨ ✓) ✓ ✓)))
         ∨ (    lamb=((   (lamb_h_preset   = ~‹[𝚲󰲟󰲡󰲣󰲥󰲧󰲩󰲫󰲭󰲯󰲱]›)
                        ∨ (lamb_h_normal   = 󰆴'⥌' 𝖶 ⠶𝝀𝑃? 󰆴'↦' )
                        ∨ (lamb_h_implicit =      𝑣  𝖶   󰆴'↦' )
                      ) 𝖶 (𝑋𝐶 󰆴'󰅂' ∨ 𝑋↓↑))))

𝔸𝕂 = (𝔸 = 󰆴'⠤' 𝖶 𝑋↓↑) ∨ (𝕂 = 󰆴'⠶' 𝖶 𝑋↓↑)
slice = (𝑋↓↓ ∨ ᗜ) (󰆴':' 𝗐 (𝑋↓↓ ∨ ᗜ))+

pargs_i   = ((parg_i = 𝑋↓↑   𝗐 󰆴'=' 𝗐 ptarg) ∨ ptarg) (𝗐 󰆴',' 𝗐 ⠶(pargs_i?))?
pargs_e   = ((parg_e = ptarg 𝗐 󰆴'=' 𝗐 𝑋↓↑  ) ∨ ptarg) (𝗐 󰆴',' 𝗐 ⠶(pargs_e?))?
ptarg     = '*' ∨ '@' ∨ 𝑣 ∨ 𝑣_spec ∨ op_lit
import    = 󰆴'⨡' (((󰆴󰜚 ~‹[^󰜛]+› 󰆴󰜛 ∨ ✓) 𝖶      )
                  (str_tsub ∨ str_nsub ∨ str_timp  )
                  (𝖶 󰆴'⭸' 𝖶 pargs_i             ∨ ✓)
                  (𝗐 󰆴';'         ✓ ∨ 𝗐 ⠶import ∨ ✓))
export    = 󰆴'⭷' 𝖶 pargs_e
str_timp  = ⠶timp_guts (𝘄 ⠶timp_guts)* 𝗐
timp_guts = ⠶(str_sub_inner ∨ str_timp_guts)+

native_code = 󰆴'⦃' (~‹[^⦃⦄␛␛]+› ∨ 󰆴"␛␛" ~‹.› ∨ 󰆴'⦃' 𝖶 𝑋𝐶? 𝖶 󰆴'⦄' )* 󰆴'⦄'

pos_num = ƨ(~‹0([bB][01]+|[oO][0-7]+|[xX][0-9a-fA-F]+)|([0-9]+(\.[0-9]*)?|[0-9]*\.[0-9]+)(e[+\-]?[0-9]+)?›)
neg_num = ƨ(~‹󷰽([󷱈󷱐][󷰽󷰾]+|[󷱍󷱕][󷰽-󷱄]+|[󷱎󷱖][󷰽-󷱆󷱇-󷱌󷱏-󷱔]+)|([󷰽-󷱆]+(\.[󷰽-󷱆]*)?|[󷰽-󷱆]*\.[󷰽-󷱆]+)(󷱋[+\-]?[󷰽-󷱆]+)?›)
number     = pos_num ∨ neg_num
number_exp = number sup
script = ( (sub = 󰆴󰜞 𝖶 𝑋𝐶 𝖶 󰆴󰜛)
          ∨(sup = 󰆴󰜚 𝖶 𝑋𝐶 𝖶 󰆴󰜛))
grp = ~"[⁅⟦]" 𝖶 (𝑋𝐶 ∨ ✓) 𝖶 ~"[⁆⟧]"

op = op_⸓_l op_lit op_⸓_r
op⸓l_g = ⠶op_⸓_ly ⠶sup?
op⸓r_g = ⠶op_⸓_ry ⠶sup?
op_⸓_l = (⮞(op_⸓_ln ∨ op_⸓_ly) ((op_⸓_ln ∨ op⸓l_g ∨ 𝚜) 𝗐)*)?
op_⸓_r =                       ((op_⸓_rn ∨ op⸓r_g ∨ 𝚜) 𝗐)*
𝚜 = ⠶sup

𝑣 = ((󰆴'´' ~‹[^´]+› ∨ ƨ(op_lit)) 󰆴'´') ∨ ƨ((¬𝑣_bad ~‹.›)+)
𝑣_bad = (𝗪 ∨ ~‹󰦥{5}|[;:,⬠=∀¿⍈󷸴⍮⨡⭸⭷⟥⟤⭡⭣𝗮-𝘇𝟬-𝟵󷺗ᐸᐳᑅᑀᐘᐒᑈᐵᐛᐖ󷺹-󷻀⥌↦𝚲󰲟󰲡󰲣󰲥󰲧󰲩󰲫󰲭󰲯󰲱󰅂$"'\[\](){}⦉⦊⁅⁆⟦⟧⟨⟩⦃⦄󰜞󰜚󰜛‹ ␛␛␛›]›
           ∨ σscript ∨ op_⸓_ln ∨ op_⸓_ly ∨ op_lit ∨ script ∨ 𝑣_spec ∨ std_kwd ∨ blk_cln_kwd ∨ blk_kwd)

W_L = (‹⟥›∨✓) ~‹[ᐳᑀᐒᐵᐖ󷺹󷺻󷺺󷺼]›
W_R =         ~‹[ᐸᑅᐘᑈᐛ󷺽󷺿󷺾󷻀]› (‹⟤›∨✓)

sys_call_stupid_script_hack = '$' 𝗐 ⮞σsup σscript 𝗐 str_tsys
sys_call = 󰆴'$' 𝗐 (󰆴󰜚 ~‹[^󰜛]+› 󰆴󰜛 ∨ ✓) 𝗐 str_tsys
str = empty_str ∨ ((str_t󰦥 ∨ str_tsub ∨ str_nsub ∨ ⠶str_gen_inner) 𝗐)+
str_t󰦥   = 󰆴(~‹󰦥{5}›) ~‹((?!󰦥{5})(.|\n))*› 󰆴(~‹󰦥{5}› ∨ ✓)
str_tsys = (⠶str_sub_inner ∨ str_tsys_guts)* 󰆴'󷹹'
str_tsub = 󰆴'‹'                   (⠶str_sub_inner ∨ str_tsub_guts)* 󰆴'›'
str_tsys_guts = ~"[^𝗮-𝘇𝟬-𝟵󷺗␛␛⟦󷹹]+"
str_tsub_guts = ~"[^𝗮-𝘇𝟬-𝟵󷺗␛␛⟦␛›]+"
str_timp_guts = ~"[^𝗮-𝘇𝟬-𝟵󷺗␛␛⟦;⨡⭸ \t\n]+"
str_nsub = ⠶(str_nsub1 ∨ str_nsub2)
str_nsub1 = 󰆴‹"› ↷ (⠶str_gen_inner ∨ (str_nsub1_guts = ~‹[^𝗮-𝘇𝟬-𝟵󷺗␛␛"]+›))*
str_nsub2 = 󰆴‹'› ↷ (⠶str_gen_inner ∨ (str_nsub2_guts = ~‹[^𝗮-𝘇𝟬-𝟵󷺗␛␛']+›))*

empty_str = 󰆴'󷺗' ""
str_sub_inner = ⠶str_gen_inner ∨ str_sub
str_gen_inner = (str_escape ∨ 󰆴'󷺗' ∨ str_spec_char)+
str_sub = 󰆴'⟦' 𝖶 𝑋𝐶? 󰆴'⟧'
str_spec_char = ~‹[𝟬-𝟵𝗮-𝗳]{2}|[𝗮-𝘇󷺗]›
str_escape = 󰆴"␛␛" ~‹.›
str_guts = ~"[^𝗮-𝘇𝟬-𝟵󷺗⟦␛␛›'␛"󷹹]+"

ugx_x     = ugx_brack
ugx_mod   = 󰆴󰜚 ~‹[?*+⮞¬]› 󰆴󰜛
ugx_and   = ⠶ugx_atom+
ugx_or    = ugx_and 󰆴'󷸴' 𝖶 (⠶ugx_or ∨ ugx_and)
ugx_☾     = 𝑋𝐶 𝖶 󰆴'⍮'? (mod:ugx_mod)?
ugx_seq   = ((ugx_or ∨ ⠶ugx_atom) 𝖶)+ (󰆴'⍈' 𝖶 apply@=𝑋𝐶)?
ugx_atom  = (ugx_group ∨ ugx_☾    ) 𝖶
ugx_group = (ugx_paren ∨ ugx_brack)
ugx_gtail = (mod@=(𝖶 ∧ ugx_mod))? (𝗐 ∧ stk@=sub)?
ugx_paren = 󰆴'(' 𝖶 ⠶ugx_seq 󰆴')' ⠶ugx_gtail
ugx_brack = 󰆴'⟨' 𝖶 ⠶ugx_seq 󰆴'⟩' ⠶ugx_gtail

󰜞 = '󰜞'
󰜛 = '󰜛'
󰜚 = '󰜚'
ᗜ = 𝗐 ''
𝘄 = 󰆴(~‹(␛␛\n|[ \t])+›  )
𝗪 = 󰆴(~‹(␛␛\n|[ \t\n])+›)
comment = ~‹((|#)[^\n]*(?=\n|\Z))|(🟑[^🟑]*(🟑|\Z))|(֎[^֎]*(֎|\Z))›

󰦥󰦥󰦥󰦥󰦥